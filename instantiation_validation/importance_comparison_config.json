{
  "runs": [
    {
      "name": "DOELG",
      "event_dir": "../data/paper_reproduction/doelg/output_event_maps_grid/geotiff",
      "factor_dir": "../data/paper_reproduction/doelg/output_factor_maps_grid_geotiff"
    },
    {
      "name": "OELG",
      "event_dir": "../data/paper_reproduction/oelg/output_event_maps_grid/geotiff",
      "factor_dir": "../data/paper_reproduction/oelg/output_factor_maps_grid_geotiff"
    }
  ],
  "point_sets": {
    "Subsidence": {
      "path": "../data/validation_points/Subsidence/Subsidence.shp",
      "exclude_status": []
    },
    "waterlogging": {
      "path": "../data/validation_points/waterlogging/郑州积水_WGS84.shp",
      "exclude_status": []
    }
  },
  "event_pairs": [
    {
      "file": "Subsidence_importance.tif",
      "points": "Subsidence"
    },
    {
      "file": "Waterlogging_importance.tif",
      "points": "waterlogging"
    }
  ],
  "factor_glob": "*_importance_field.tif",
  "factor_fields_by_point_set": {
    "Subsidence": [
      "Subsidence Depth",
      "Crack Width",
      "Tilt Angle",
      "Structural Characteristics"
    ],
    "waterlogging": [
      "Water Body Area",
      "Water Level",
      "Precipitation",
      "Soil Moisture"
    ]
  },
  "area_mode": "geodesic",
  "outside_policy": "error",
  "area_fractions": [
    0.05,
    0.1,
    0.2,
    0.3
  ],
  "hit_target": 0.8,
  "score_thresholds": [],
  "validation_independent": false,
  "comparison": {
    "reference": "DOELG",
    "candidate": "OELG"
  },
  "method_notes": [
    "Frozen KGC_2 common_scale_2 inputs reproduce the fields reported in Tables 6 and 7.",
    "Both methods use the archived aligned 200 by 200 grid, validation points, geometry kernels, and logarithmic overlap enhancement.",
    "DOELG retains 394 factor-to-event associations from the paper snapshot; later instance databases are not substituted.",
    "The archived OELG graph uses strict environment constraints and depth_decay=0.5. Its scores are relative priorities, not calibrated probabilities.",
    "The observations and abstract knowledge originate from events-logic-all-1zz-sensor-en-0904. Historical modeling-input independence has not been independently established."
  ],
  "output_dir": "../data/paper_reproduction/comparison"
}
